# Copy to .env and fill in.

# Django signing key. Required in any real deployment.
SECRET_KEY=dev-only-insecure-key-change-me

# Set to 0/false in anything that is not a developer machine.
DJANGO_DEBUG=1

# Comma-separated. Leave empty for local development.
ALLOWED_HOSTS=

# YouTube Data API v3 key. Required only to COLLECT a new dataset (POST).
# Analysing an already-collected file under input_files/ (GET) works without it,
# and the committed input_files/travel.csv gives you something to analyse
# immediately.
GOOGLE_API_KEY=
