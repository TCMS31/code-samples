# Copy to .env (next to manage.py) and fill in.
# Every value has a working default, so the API starts without this file.

# Django signing key. Required in any real deployment.
SECRET_KEY=dev-only-insecure-key-change-me

# Set to 0/false in anything that is not a developer machine.
# This used to be derived from SECRET_KEY, so DEBUG was on wherever a key was set.
DJANGO_DEBUG=1

# Comma-separated. Leave empty for local development.
ALLOWED_HOSTS=

# Browser origins allowed to call this API.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8614

# Log entries returned per page.
PAGE_SIZE=50
