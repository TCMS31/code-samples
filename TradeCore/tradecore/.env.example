# Copy to .env and fill in. Every value below is optional for local development:
# with none of them set the API still starts, signs users up and issues tokens.

# Django signing key. Required in any real deployment.
SECRET_KEY=dev-only-insecure-key-change-me

# Set to 0/false in anything that is not a developer machine.
DJANGO_DEBUG=1

# Comma-separated. Leave empty for local development.
ALLOWED_HOSTS=

# Optional signup enrichment (https://www.abstractapi.com).
# Leave blank and the lookups are skipped entirely - no network call is made
# and signup still succeeds with empty geolocation data.
ABSTRACT_GEOLOCATION_API_KEY=
ABSTRACT_HOLIDAYS_API_KEY=
ABSTRACT_API_TIMEOUT=5
